@model WebsiteOrdering.Models.Datban

<h2 class="text-center">Chi tiết đơn đặt bàn</h2>

<table class="table">
    <tr>
        <th>Mã đặt bàn</th>
        <td>@Model.Iddatban</td>
    </tr>
    <tr>
        <th>Họ tên người đặt</th>
        <td>@Model.Tenngdat</td>
    </tr>
    <tr>
        <th>Số điện thoại</th>
        <td>@Model.Sđtngdat</td>
    </tr>
    <tr>
        <th>Email</th>
        <td>@Model.Nguoidung?.Email</td>
    </tr>
    <tr>
        <th>Chi nhánh</th>
        <td>@Model.IdchinhanhNavigation?.Tencnhanh</td>
    </tr>
    <tr>
        <th>Ngày đặt</th>
        <td>@Model.Ngaydat.ToString("dd/MM/yyyy")</td>
    </tr>
    <tr>
        <th>Giờ bắt đầu</th>
        <td>@Model.Giobatdau.ToString(@"HH:mm")</td>
    </tr>
    <tr>
        <th>Giờ kết thúc</th>
        <td>@Model.Gioketthuc.ToString(@"HH:mm")</td>
    </tr>
    <tr>
        <th>Số người</th>
        <td>@Model.Songuoidat</td>
    </tr>
    <tr>
        <th>Ghi chú</th>
        <td>@Model.Ghichu</td>
    </tr>
    <tr>
        <th>Trạng thái</th>
        <td>@Model.Trangthaidatban</td>
    </tr>
</table>

<h4>Bàn đã đặt</h4>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tên bàn</th>
            <th>Khu vực</th>
            <th>Giờ vào</th>
            <th>Giờ ra</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ct in Model.Chitietdatbans)
        {
            <tr>
                <td>@ct.IdbanNavigation?.Tenban</td>
                <td>@ct.IdbanNavigation?.Khuvuc</td>
                <td>@ct.Giovao.ToString(@"HH:mm")</td>
                <td>@ct.Giora.ToString(@"HH:mm")</td>
            </tr>
        }
    </tbody>
</table>
