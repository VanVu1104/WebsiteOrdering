    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@using WebsiteOrdering.Models
@model WebsiteOrdering.Models.Datban

@{
    ViewData["Title"] = "Đặt bàn";
    var chiNhanhs = ViewBag.ChiNhanh as List<Chinhanh>;
    var banss = ViewBag.Ban as List<Ban>;
}

@section Scripts {
<script src="~/js/indexbooking.js"></script>
}

@* <form asp-action="SearchDonDatBan" asp-controller="Booking"  method="get">
    <button type="submit" class="btn btn-primary">Tra cứu đơn đặt bàn</button>
</form> *@
<a asp-action="SearchDonDatBan" asp-controller="Booking" class="btn btn-primary">Tra cứu đơn đặt bàn</a>

<h2 class="text-center">Đặt bàn</h2>


@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-action="DatBan" asp-controller="Booking" method="post">
   @*  <input name="trangThaiHopLe" value="@(ViewBag.Trangthaidatban)"/> *@
    <div class="form-group">
        <label>Họ tên</label>
        <input type="text" name="Tenngdat" class="form-control" value="@((ViewBag.UserInfo as ApplicationUser)?.UserName)" required />
    </div>

    <div class="form-group">
        <label>Email</label>
        <input type="email" name="user.Email" class="form-control" value="@((ViewBag.UserInfo as ApplicationUser)?.Email)" required />
    </div>

    <div class="form-group">
        <label>Số điện thoại</label>
        <input type="tel" name="Sđtngdat" class="form-control" value="@((ViewBag.UserInfo as ApplicationUser)?.PhoneNumber)"  required />
    </div>

    <div class="form-group">
        <label>Số người</label>
        <input asp-for="Songuoidat" class="form-control" type="number" min="1" max="10" required />
        <small id="warning" class="form-text text-danger" style="display:none;">
            Với số lượng > 10 người, vui lòng liên hệ nhà hàng qua số điện thoại: 0123-456-789
        </small>
    </div>

    <div class="form-group">
        <label>Ngày đặt</label>
        <input asp-for="Ngaydat" type="date" class="form-control" min="@DateTime.Now.ToString("yyyy-MM-dd")" required />

    </div>

    <div class="form-group">
        <label>Giờ bắt đầu</label>
        <select name="Giobatdau" class="form-control" required></select>
    </div>

    <div class="form-group">
        <label>Ghi chú (nếu có)</label>
        <textarea asp-for="Ghichu" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label>Chi nhánh</label>
        <select id="selectChinhanh" name="Idchinhanh" class="form-control" required>
            <option value="">-- Chọn chi nhánh --</option>
            @foreach (var cn in chiNhanhs)
            {
                <option value="@cn.Idchinhanh">@cn.Tencnhanh</option>
            }
        </select>
    </div>

    <!-- Khu vực -->
    <div class="form-group">
        <label>Khu vực</label>
        <select id="selectKhuvuc" class="form-control" required>
            <option value="">-- Chọn khu vực --</option>
            @foreach (var kv in banss)
            {
                <option value="@kv.Idban">@kv.Khuvuc</option>
            }
        </select>
    </div>

    <!-- Bàn -->
    <div class="form-group">
        <label>Bàn</label>
        <div id="banInfo" style="font-weight: bold; color: green;">Chưa chọn bàn</div>
        <input type="hidden" id="selectedIdban" name="selectedIdban" required />
        <canvas id="canvas" width="1300" height="800"></canvas>
    </div>
    <button type="button" class="btn btn-primary" onclick="openConfirmation()">Đặt bàn <span style="color:red">(05:00s)</span></button>
</form>

@* Hiển thị dialog hiển thị xác nhận đặt bàn *@
<div id="confirmModal" class="custom-modal">
    <div class="custom-modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Xác nhận đặt bàn</h5>
            <button type="button"  class="close-btn" onclick="closeModal()" >
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
      
        <h4>Điều khoản sử dụng bàn tại nhà hàng</h4>
        <ul>
            <li>Khách hàng được sử dụng bàn trong <strong>tối đa 2 tiếng</strong> tính từ giờ bắt đầu đã chọn.</li>
            <li>Giờ kết thúc sẽ là <strong>2 tiếng sau giờ bắt đầu</strong>.</li>
            <li>Nhà hàng chỉ giữ bàn trong vòng <strong>15 phút</strong> từ giờ bắt đầu.</li>
            <li>Nếu khách không đến sau thời gian này, <strong>đặt bàn sẽ bị hủy</strong> để đảm bảo quyền lợi cho người khác.</li>
        </ul>
        <p>Vui lòng kiểm tra kỹ thông tin trước khi xác nhận.</p>
        <label>
            <input type="checkbox" id="agreeCheckbox"> Tôi đã đọc và đồng ý với điều khoản
        </label>
        <div class="modal-footer">
            <button onclick="closeModal()">Hủy</button>
            <button onclick="submitBooking()" id="confirmBtn" disabled>Đồng ý</button>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f5f5f5;
    }

    #canvas {
        background-color: white;
        border: 2px dashed #ccc;
        border-radius: 12px;
        display:none;
    }

    .custom-modal {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
    }

    .custom-modal-content {
        background-color: #fff;
        margin: 10% auto;
        padding: 20px;
        width: 80%;
        max-width: 500px;
        border-radius: 8px;
        position: relative;
        box-shadow: 0 0 10px rgba(0,0,0,0.3);
    }

    .close-btn {
        position: absolute;
        top: 10px;
        right: 15px;
        font-size: 24px;
        background: none;
        border: none;
        cursor: pointer;
    }

    .modal-footer {
        margin-top: 20px;
        text-align: right;
    }
</style>
