@model WebsiteOrdering.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<form asp-action="Login" method="post">
    @if (!string.IsNullOrEmpty(ViewBag.ReturnUrl))
    {
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    }
    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>
    <div>
        <label asp-for="Password"></label>
        <input asp-for="Password" />
        <span asp-validation-for="Password"></span>
    </div>
    <div>
        <input asp-for="RememberMe" /> Remember me
    </div>
    <div class="mt-2 mb-3">
        <a asp-action="ForgotPassword">Quên mật khẩu?</a>
    </div>
    <button type="submit">Login</button>
</form>
<p>
    Chưa có tài khoản? <a asp-action="Register">Đăng ký</a>
</p>
<a href="@Url.Action("LoginWithGoogle", "Account", new { returnUrl = ViewBag.ReturnUrl })">
        <p>Đăng nhập bằng Google</p>
</a>

<p>
    <a asp-area="Admin" asp-controller="Admin" asp-action="LoginStaff">Đăng nhập cho nhân viên</a>
</p>
<partial name="_ValidationScriptsPartial" />