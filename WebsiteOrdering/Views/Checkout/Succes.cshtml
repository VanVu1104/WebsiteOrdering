@model WebsiteOrdering.Models.Donhang
<h2>Đặt hàng thành công!</h2>
<p>Mã đơn hàng: <strong>@Model.Iddonhang</strong></p>
<p>Khách hàng: @Model.Tenkh</p>
<p>Số điện thoại: @Model.Sdtkh</p>
<p>Địa chỉ: @Model.Diachidh</p>
<p>Ngày đặt: @Model.Ngaydat.ToString("dd/MM/yyyy HH:mm")</p>
<p>Phương thức thanh toán: @Model.Ptttoan</p>
<p><strong>Tổng tiền: @Model.Tongtien.ToString("N0") đ</strong></p>

<hr />
<h3>Chi tiết đơn hàng</h3>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Món ăn</th>
            <th>Số lượng</th>
            <th>Giá</th>
            <th>Tổng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Chitietdonhangs)
        {
            <tr>
                <td>
                    <div>@item.IdmonanNavigation?.Tenmonan</div>
                    @if (!string.IsNullOrEmpty(item.Idmonan2))
                    {
                        <div>+ @item.Kieupizza</div>
                    }
                    @if (item.Chitiettoppings?.Any() == true)
                    {
                        <div>Topping:</div>
                        <ul>
                            @foreach (var top in item.Chitiettoppings)
                            {
                                <li>@top.IdtoppingNavigation?.Tentopping</li>
                            }
                        </ul>
                    }
                    @if (!string.IsNullOrEmpty(item.Ghichu))
                    {
                        <div>Ghi chú: @item.Ghichu</div>
                    }
                </td>
                <td>@item.Soluong</td>
                <td>@item.Dongia.ToString("N0") đ</td>
                <td>@item.Tongtiendh.ToString("N0") đ</td>
            </tr>
        }
    </tbody>
</table>
