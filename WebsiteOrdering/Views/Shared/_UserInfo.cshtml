@model WebsiteOrdering.ViewModels.UserCheckoutInfoViewModel
<link rel="stylesheet" href="~/css/style.css" />

<div class="checkout-info-card">
    <div class="checkout-info-card-body">
        <h5 class="checkout-info-card-title">Thông tin đặt hàng</h5>

        <div class="checkout-info-mb-2">
            <strong>Tên người nhận</strong>
            @if (!string.IsNullOrEmpty(Model.FullName))
            {
                <input type="text" name="FullName" class="checkout-info-input checkout-info-input-sm"
                       placeholder="Nhập họ tên" value="@Model.FullName" />
            }
            else
            {
                <input type="text" name="FullName" class="checkout-info-input checkout-info-input-sm" placeholder="Nhập họ tên">
            }
        </div>

        <div class="checkout-info-mb-2">
            <strong>Số điện thoại</strong>
            @if (!string.IsNullOrEmpty(Model.PhoneNumber))
            {
                <input type="text" name="PhoneNumber" class="checkout-info-input checkout-info-input-sm"
                       placeholder="Nhập số điện thoại" value="@Model.PhoneNumber" />
            }
            else
            {
                <input type="text" name="PhoneNumber" class="checkout-info-input checkout-info-input-sm" placeholder="Nhập số điện thoại">
            }
        </div>

        <div class="checkout-info-mb-2">
            @if (Model.DeliveryMethod == "delivery")
            {
                <input type="hidden" name="DeliveryMethod" value="@Model.DeliveryMethod" />

                <strong>Địa chỉ giao hàng</strong>
                <input type="text" id="userAddress" class="checkout-info-input" value="@Model.Address" readonly />
                <input type="hidden" name="Address" value="@Model.Address" />

                <div class="checkout-info-row">
                    <div class="checkout-info-half">
                        <strong>Giao hàng từ</strong>
                        <input type="text" class="checkout-info-input" value="@Model.BranchName" readonly />
                        <input type="hidden" name="BranchName" value="@Model.BranchName" />
                        <input type="hidden" name="BranchId" value="@Model.BranchId" />
                    </div>
                    <div class="checkout-info-half">
                        <strong>Số km</strong>
                        <input type="text" class="checkout-info-input" value="@Model.DistanceKm km" readonly />
                        <input type="hidden" name="DistanceKm" value="@Model.DistanceKm" />
                    </div>
                </div>

                <div class="checkout-info-full">
                    <strong>Thời gian giao hàng dự kiến</strong>
                    <input type="text" class="checkout-info-input" value="@Model.EstimatedMinutes phút" readonly />
                    <input type="hidden" name="EstimatedMinutes" value="@Model.EstimatedMinutes" />
                </div>
            }
            else
            {
                <input type="hidden" name="DeliveryMethod" value="@Model.DeliveryMethod" />
                <strong>Nhận hàng tại cửa hàng</strong>
                <input type="text" class="checkout-info-input" value="@Model.BranchName" readonly />
                <input type="hidden" name="BranchName" value="@Model.BranchName" />
                <input type="hidden" name="BranchId" value="@Model.BranchId" />

                <div class="checkout-info-row">
                    <div class="checkout-info-half">
                        <strong>Khoảng cách</strong>
                        <input type="text" class="checkout-info-input" value="@Model.DistanceKm km" readonly />
                        <input type="hidden" name="DistanceKm" value="@Model.DistanceKm" />
                    </div>
                    <div class="checkout-info-half">
                        <strong>Thời gian đi dự kiến</strong>
                        <input type="text" class="checkout-info-input" value="@Model.EstimatedMinutes phút" readonly />
                        <input type="hidden" name="EstimatedMinutes" value="@Model.EstimatedMinutes" />
                    </div>
                </div>
            }

            <button type="button" class="checkout-info-btn"
                    onclick="location.href='@Url.Action("Index", "Location")'">
                Thay đổi địa chỉ
            </button>
        </div>

        <div class="checkout-info-form-group checkout-info-mb-3">
            <strong>Phương thức thanh toán *</strong>
            <div class="checkout-info-mt-2">
                <div class="checkout-info-form-check">
                    <input class="checkout-info-form-check-input" type="radio" name="PaymentInfo" id="paymentCOD" value="COD" checked>
                    <label class="checkout-info-form-check-label" for="paymentCOD">
                        Thanh toán khi nhận hàng
                    </label>
                </div>
                <div class="checkout-info-form-check">
                    <input class="checkout-info-form-check-input" type="radio" name="PaymentInfo" id="paymentVNPay" value="VNPay">
                    <label class="checkout-info-form-check-label" for="paymentVNPay">
                        Thanh toán qua VNPay
                    </label>
                </div>
            </div>
        </div>
    </div>
</div>