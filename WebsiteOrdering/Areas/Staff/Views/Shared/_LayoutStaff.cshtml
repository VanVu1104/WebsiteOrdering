@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@*
    Layout dành riêng cho Nhân viên
*@
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Staff</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .admin-container {
            display: flex;
        }

        .sidebar {
            width: 200px;
            background-color: #f0f0f0;
            padding: 1rem;
        }

            .sidebar a.sidebar-link {
                display: block;
                padding: 10px;
                margin: 5px 0;
                background-color: #ddd;
                text-decoration: none;
                color: black;
                border-radius: 5px;
            }

                .sidebar a.sidebar-link:hover {
                    background-color: #bbb;
                }

        .logout-button {
            margin-top: 10px;
            padding: 10px;
            width: 100%;
            background-color: #e74c3c;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .content {
            flex: 1;
            padding: 1rem;
        }
    </style>
</head>
<body>
    <div class="admin-container">
        <div class="sidebar">
            <h4>Quản lý Nhân viên</h4>

            <a class="sidebar-link" asp-area="Staff" asp-controller="BookingStaff" asp-action="Index">Đơn đặt bàn</a>
            <a class="sidebar-link" asp-area="Staff" asp-controller="Staff" asp-action="Index">Trang chủ</a>

            <form asp-area="Staff" asp-controller="Staff" asp-action="LogoutStaff" method="post">
                <button type="submit" class="logout-button">Đăng xuất</button>
            </form>
        </div>

        <div class="content">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
