@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@*
    Layout dành riêng cho Nhân viên
*@
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staff</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />


    @await RenderSectionAsync("Styles", required: false)


    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-..." crossorigin="anonymous" referrerpolicy="no-referrer" />

    <style>
        .admin-container {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 250px;
            background-color: #f8f9fa;
            padding: 1rem;
            border-right: 1px solid #dee2e6;
            box-shadow: 2px 0 5px rgba(0,0,0,0.1);
        }

            .sidebar h4 {
                color: #495057;
                margin-bottom: 1rem;
                padding-bottom: 0.5rem;
                border-bottom: 2px solid #007bff;
            }

            .sidebar a.sidebar-link {
                display: block;
                padding: 12px 15px;
                margin: 5px 0;
                background-color: #ffffff;
                text-decoration: none;
                color: #495057;
                border-radius: 8px;
                border: 1px solid #dee2e6;
                transition: all 0.3s ease;
            }

                .sidebar a.sidebar-link:hover {
                    background-color: #007bff;
                    color: white;
                    transform: translateX(5px);
                }

        .logout-button {
            margin-top: 20px;
            padding: 12px 15px;
            width: 100%;
            background-color: #dc3545;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 500;
            transition: background-color 0.3s ease;
        }

            .logout-button:hover {
                background-color: #c82333;
            }

        .content {
            flex: 1;
            padding: 2rem;
            background-color: #ffffff;
        }

        /* Bootstrap form styles */
        .form-label {
            font-weight: 500;
            color: #495057;
            margin-bottom: 0.5rem;
        }

        .form-control, .form-select {
            border-radius: 6px;
            border: 1px solid #ced4da;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        }

            .form-control:focus, .form-select:focus {
                border-color: #007bff;
                box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
            }

        .btn {
            border-radius: 6px;
            padding: 0.5rem 1rem;
            font-weight: 500;
        }

        .btn-primary {
            background-color: #007bff;
            border-color: #007bff;
        }

            .btn-primary:hover {
                background-color: #0056b3;
                border-color: #0056b3;
            }

        .alert {
            border-radius: 6px;
            margin-bottom: 1rem;
        }

        .space-y-4 > * + * {
            margin-top: 1rem;
        }

        .text-2xl {
            font-size: 1.5rem;
        }

        .font-bold {
            font-weight: 700;
        }

        .mb-4 {
            margin-bottom: 1.5rem;
        }

        .text-muted {
            color: #6c757d !important;
            font-size: 0.875rem;
        }
    </style>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <div class="admin-container">
        <div class="sidebar">

            <h4>Quản lý Nhân viên</h4>
            <a class="sidebar-link" asp-area="Staff" asp-controller="Staff" asp-action="Index">🏠 Trang chủ</a>
            <a class="sidebar-link" asp-area="Staff" asp-controller="BookingStaff" asp-action="Index">📋 Đơn đặt bàn</a>
            <a class="sidebar-link" asp-area="Staff" asp-controller="BookingStaff" asp-action="CreateDatBanTaiCho">➕ Tạo đơn đặt bàn</a>
            <a class="sidebar-link" asp-area="Staff" asp-controller="BookingStaff" asp-action="DanhSachKhachDaDen">👥 Danh sách khách đã đến</a>
            <a class="sidebar-link" asp-area="Staff" asp-controller="Orders" asp-action="">Danh sách đơn hàng</a>


            <form asp-area="Staff" asp-controller="Staff" asp-action="LogoutStaff" method="post">
                <button type="submit" class="logout-button">🚪 Đăng xuất</button>
            </form>
        </div>

        <div class="content">
            @RenderBody()
        </div>
    </div>

    <!-- jQuery (cần thiết cho một số chức năng) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom Scripts -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>